{
  "schema_version": "1.0",
  "transitions": {
    "GUARD": {
      "allowed": ["EXTENSION"]
    },
    "EXTENSION": {
      "allowed": ["FULL_EXTENSION"],
      "timeout_ms": 700,
      "timeout_action": "ABORT_REPETITION"
    },
    "FULL_EXTENSION": {
      "allowed": ["RETRACTION"],
      "timeout_ms": 550,
      "timeout_action": "ABORT_REPETITION"
    },
    "RETRACTION": {
      "allowed": ["RECOVERY"],
      "timeout_ms": 700,
      "timeout_action": "ABORT_REPETITION"
    },
    "RECOVERY": {
      "allowed": ["GUARD"],
      "timeout_ms": 1200,
      "timeout_action": "ABORT_REPETITION",
      "completes_repetition": true
    }
  }
}
